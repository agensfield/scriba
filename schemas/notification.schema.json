{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agensfield.dev/scriba/schemas/notification.schema.json","title":"Scriba external notification","type":"object","additionalProperties":false,"required":["schemaVersion","eventId","eventKind","source","occurredAt","data"],"properties":{"schemaVersion":{"const":"scriba.notification.v2"},"eventId":{"type":"string","minLength":1},"eventKind":{"enum":["reset","limit_warning","pacing_warning","reset_grant_warning","reset_grant","radar_alert"]},"source":{"type":"string","minLength":1},"accountId":{"type":"string","pattern":"^acct-[0-9a-f]{20}$"},"occurredAt":{"type":"string","format":"date-time"},"data":{"type":"object"}},"allOf":[{"if":{"properties":{"eventKind":{"const":"radar_alert"}},"required":["eventKind"]},"then":{"not":{"required":["accountId"]}},"else":{"required":["accountId"]}}]}
