{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agensfield.dev/scriba/schemas/notification.schema.json","title":"Scriba external notification","type":"object","additionalProperties":false,"required":["schemaVersion","eventId","eventKind","source","occurredAt","data"],"properties":{"schemaVersion":{"const":"scriba.notification.v1"},"eventId":{"type":"string","minLength":1},"eventKind":{"enum":["reset","limit_warning","reset_grant_warning","reset_grant","radar_alert"]},"source":{"type":"string","minLength":1},"profileId":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","maxLength":32},"occurredAt":{"type":"string","format":"date-time"},"data":{"type":"object"}}}
