{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agensfield.dev/scriba/schemas/profiles.schema.json","title":"Scriba profile health","type":"object","additionalProperties":false,"required":["schemaVersion","defaultProfileId","profiles"],"properties":{"schemaVersion":{"const":"scriba.profiles.v1"},"defaultProfileId":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","maxLength":32},"profiles":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/profile"},"contains":{"type":"object","properties":{"isDefault":{"const":true}},"required":["isDefault"]},"minContains":1,"maxContains":1}},"$defs":{"profile":{"type":"object","additionalProperties":false,"required":["profileId","label","isDefault","status","consecutiveFailures","isStale"],"properties":{"profileId":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","maxLength":32},"label":{"type":"string","minLength":1,"maxLength":128},"isDefault":{"type":"boolean"},"status":{"enum":["unknown","ok","stale","degraded"]},"lastSuccessAt":{"type":"string","format":"date-time"},"lastAttemptAt":{"type":"string","format":"date-time"},"lastFailureAt":{"type":"string","format":"date-time"},"failureKind":{"enum":["legacy","auth","network","provider","internal","interrupted"]},"lastErrorCode":{"type":"string","pattern":"^[a-z0-9_]+$","maxLength":64},"consecutiveFailures":{"type":"integer","minimum":0},"nextPollEstimateAt":{"type":"string","format":"date-time"},"isStale":{"type":"boolean"}}}}}
