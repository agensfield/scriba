{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agensfield.dev/scriba/schemas/accounts.schema.json","title":"Scriba account list","type":"object","additionalProperties":false,"required":["schemaVersion","accounts"],"properties":{"schemaVersion":{"const":"scriba.accounts.v1"},"accounts":{"type":"array","items":{"$ref":"#/$defs/account"}}},"$defs":{"account":{"type":"object","additionalProperties":false,"required":["accountId","providerId","credentialsAvailable"],"properties":{"accountId":{"type":"string","pattern":"^acct-[0-9a-f]{20}$"},"providerId":{"type":"string","minLength":1},"alias":{"type":"string","minLength":1,"maxLength":32},"email":{"type":"string","format":"email"},"plan":{"type":"string"},"credentialsAvailable":{"type":"boolean"},"lastObservedAt":{"type":"string","format":"date-time"},"lastObservedAgeMs":{"type":"integer","minimum":0},"stale":{"type":"boolean"}}}}}
