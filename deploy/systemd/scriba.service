[Unit]
Description=Scriba Codex usage tracker and Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=CODEX_HOME=%h/.codex
Environment=SCRIBA_CONFIG=%h/.config/scriba/config.json
EnvironmentFile=-%h/.config/scriba/scriba.env
ExecStart=%h/.local/bin/scriba server run --config %h/.config/scriba/config.json --env prod
Restart=on-failure
RestartSec=10s
UMask=0077
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=%h/.local/state %h/.cache %h/.codex
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=default.target
