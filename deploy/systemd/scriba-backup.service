[Unit]
Description=Create and verify a Scriba server backup
Documentation=https://github.com/agensfield/scriba/blob/main/docs/operations.md
ConditionPathExists=%h/.local/state/scriba/server.sqlite

[Service]
Type=oneshot
Environment=SCRIBA_CONFIG=%h/.config/scriba/config.json
ExecStart=%h/.local/bin/scriba server backup --config %h/.config/scriba/config.json --env prod --retention 14
UMask=0077
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=%h/.local/state
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
