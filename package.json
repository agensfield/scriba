{
	"name": "scriba-workspace",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"scriba": "bun run --cwd packages/scriba src/cli.ts",
		"build": "bun --filter @agensfield/scriba build",
		"smoke:package": "bun --filter @agensfield/scriba smoke:package",
		"macos:build": "swift build --package-path apps/macos",
		"macos:test": "swift test --package-path apps/macos",
		"macos:preview": "SCRIBABAR_PREVIEW_OUTPUT=$PWD/apps/macos/.build/previews/menu.png swift test --package-path apps/macos --filter 'MenuBarPreviewRenderTests'",
		"macos:package": "apps/macos/Scripts/package_app.sh debug",
		"macos:dist": "apps/macos/Scripts/package_zip.sh release",
		"macos:run": "apps/macos/Scripts/compile_and_run.sh --test",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "bun --filter @agensfield/scriba typecheck",
		"test": "bun --filter @agensfield/scriba test",
		"gate": "bun run lint && bun run typecheck && bun run test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.4",
		"@types/bun": "latest",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	},
	"packageManager": "bun@1.3.13"
}
